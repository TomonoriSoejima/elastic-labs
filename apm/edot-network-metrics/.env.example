# Copy to .env (gitignored) and fill in your sandbox deployment's real values.
# Never commit a filled-in .env.

# Elasticsearch (for ES-side mapping tests: reproduce-failure / apply-fix / verify-rollover)
ES_URL=https://your-deployment.es.region.gcp.cloud.es.io:443
ES_USER=elastic
ES_PASSWORD=change-me

# APM/OTLP native endpoint (for the docker-repro EDOT collector configs)
APM_ENDPOINT=your-deployment.apm.region.gcp.cloud.es.io:443
APM_API_KEY=change-me-base64-id:key

# Data stream under test
DATA_STREAM=metrics-apm.app.mfrs_judge_system-default
COMPONENT_TEMPLATE=metrics-apm.app@custom
